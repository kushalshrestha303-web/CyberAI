{
  "notice": "Synthetic educational fixture. Not live telemetry.",
  "workflow": {
    "id": "soc",
    "version": 1,
    "title": "Suspicious login → authorized response",
    "domain": "Security operations",
    "summary": "Follow one synthetic event through collection, detection, evidence review and a guarded response. Change the scenario or decision to explore a different path.",
    "references": [
      {
        "title": "Microsoft · Investigate risky users",
        "url": "https://learn.microsoft.com/en-us/entra/id-protection/howto-identity-protection-investigate-risk"
      },
      {
        "title": "NIST SP 800-61 Rev. 3 · Incident response",
        "url": "https://csrc.nist.gov/pubs/sp/800/61/r3/final"
      }
    ],
    "nodes": [
      {
        "id": "event",
        "title": "Sign-in event",
        "op": "trigger",
        "description": "A synthetic event enters the lab.",
        "detail": "Documentation addresses and example.test accounts represent no real person. The selected scenario determines the evidence.",
        "position": {
          "x": 0,
          "y": 80
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "parse",
        "title": "Parse & normalize",
        "op": "parse",
        "description": "Validate and normalize the event envelope.",
        "detail": "Keep source fields and original timestamps. Normalization improves consistency without adding evidence.",
        "position": {
          "x": 280,
          "y": 80
        },
        "requires": [
          "eventId"
        ],
        "produces": [
          "normalized"
        ],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "collect",
        "title": "Telemetry collection",
        "op": "collect",
        "description": "Collect only scoped lab telemetry.",
        "detail": "Real collectors need least-privilege authentication, health monitoring and explicit tenant scope.",
        "position": {
          "x": 560,
          "y": 80
        },
        "requires": [
          "normalized"
        ],
        "produces": [
          "collected"
        ],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "siem",
        "title": "SIEM ingestion",
        "op": "siem",
        "description": "Place the event in the synthetic log index.",
        "detail": "The sample query is educational pseudocode. It does not run against Sentinel, Splunk or a production SIEM.",
        "position": {
          "x": 840,
          "y": 80
        },
        "requires": [
          "collected"
        ],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "detect",
        "title": "Detection rule",
        "op": "detect",
        "description": "Evaluate explicit demonstration rules.",
        "detail": "A rule match is a lead, not proof of compromise. Brute-force uses the adjustable failure threshold; other scenarios use contextual signals.",
        "position": {
          "x": 840,
          "y": 300
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "alert",
        "title": "Alert triage",
        "op": "alert",
        "description": "Create an alert only when the rule matches.",
        "detail": "Preserve raw evidence and reduce duplicate notifications. Match severity to analyst handling, not an invented probability.",
        "position": {
          "x": 560,
          "y": 300
        },
        "requires": [
          "matched"
        ],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "enrich",
        "title": "Context enrichment",
        "op": "enrich",
        "description": "Attach local scenario context.",
        "detail": "This simulation makes no third-party requests. A failed enrichment preserves uncertainty instead of marking the entity safe.",
        "position": {
          "x": 280,
          "y": 300
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "analyst",
        "title": "Analyst investigation",
        "op": "investigate",
        "description": "Check the evidence and alternative explanations.",
        "detail": "Corroborate device history, user activity, source logs and authorized changes. Keep confidence separate from severity.",
        "position": {
          "x": 0,
          "y": 300
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "decision",
        "title": "Response decision",
        "op": "decide",
        "description": "Route a matched signal to human review.",
        "detail": "An unmatched signal follows the no-action path. A match still requires explicit approval before the simulated response.",
        "position": {
          "x": 0,
          "y": 520
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "approval",
        "title": "Human approval",
        "op": "approval",
        "description": "Require explicit approval for the proposed action.",
        "detail": "The approval checkbox authorizes this lab simulation only. It never authorizes an action against a real tenant.",
        "position": {
          "x": 280,
          "y": 520
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "respond",
        "title": "Response proposal",
        "op": "respond",
        "description": "Prepare a reversible containment proposal.",
        "detail": "Dry-run only: no account is disabled, host isolated or firewall changed. A production adapter would require scoped authorization and audit.",
        "position": {
          "x": 560,
          "y": 520
        },
        "requires": [
          "approved"
        ],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "audit",
        "title": "Resolution & audit",
        "op": "audit",
        "description": "Record what happened and what remains uncertain.",
        "detail": "Document the evidence, analyst decision, approval state, actions and verification plan. No real notification is sent.",
        "position": {
          "x": 840,
          "y": 520
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      }
    ],
    "edges": [
      {
        "id": "event-parse",
        "source": "event",
        "target": "parse",
        "when": "always"
      },
      {
        "id": "parse-collect",
