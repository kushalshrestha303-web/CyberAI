        "target": "decision",
        "when": "always"
      },
      {
        "id": "decision-approval",
        "source": "decision",
        "target": "approval",
        "when": "yes"
      },
      {
        "id": "decision-audit",
        "source": "decision",
        "target": "audit",
        "when": "no"
      },
      {
        "id": "approval-respond",
        "source": "approval",
        "target": "respond",
        "when": "yes"
      },
      {
        "id": "approval-audit",
        "source": "approval",
        "target": "audit",
        "when": "no"
      },
      {
        "id": "respond-audit",
        "source": "respond",
        "target": "audit",
        "when": "always"
      }
    ]
  },
