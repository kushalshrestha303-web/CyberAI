{
  "notice": "Synthetic educational fixture. Not live telemetry.",
  "workflow": {
    "id": "tls",
    "version": 1,
    "title": "TLS 1.3 · trust before application data",
    "domain": "Cryptography",
    "summary": "Explore a simplified full TLS 1.3 handshake over TCP, including certificate validation and an abort path.",
    "references": [
      {
        "title": "IETF RFC 8446 · TLS 1.3",
        "url": "https://www.rfc-editor.org/rfc/rfc8446.html"
      },
      {
        "title": "IETF RFC 9293 · TCP",
        "url": "https://www.rfc-editor.org/rfc/rfc9293.html"
      }
    ],
    "nodes": [
      {
        "id": "dns",
        "title": "Resolve destination",
        "op": "dns",
        "description": "Resolve the training hostname conceptually.",
        "detail": "DNS resolution gives an address; it does not prove server identity. This lab makes no network requests.",
        "position": {
          "x": 0,
          "y": 80
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "syn",
        "title": "TCP SYN",
        "op": "syn",
        "description": "Check firewall policy before connecting.",
        "detail": "TLS in this lesson runs over TCP. HTTP/3 uses QUIC and is a different transport path.",
        "position": {
          "x": 280,
          "y": 80
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "synack",
        "title": "TCP SYN + ACK",
        "op": "synack",
        "description": "Acknowledge the client sequence.",
        "detail": "The synthetic server has its own sequence space.",
        "position": {
          "x": 560,
          "y": 80
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "ack",
        "title": "TCP established",
        "op": "ack",
        "description": "Complete the transport handshake.",
        "detail": "TCP alone provides no confidentiality.",
        "position": {
          "x": 840,
          "y": 80
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "hello",
        "title": "Client & Server Hello",
        "op": "hello",
        "description": "Negotiate TLS 1.3 and exchange key shares.",
        "detail": "Ephemeral key agreement supports forward secrecy. No private key travels across the connection.",
        "position": {
          "x": 840,
          "y": 300
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "certificate",
        "title": "Validate certificate",
        "op": "certificate",
        "description": "Verify identity, trust chain and handshake signature.",
        "detail": "Encrypted handshake messages follow ServerHello in TLS 1.3. A trust or hostname failure aborts the connection.",
        "position": {
          "x": 560,
          "y": 300
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "keys",
        "title": "Application keys",
        "op": "keys",
        "description": "Derive application traffic secrets and verify Finished.",
        "detail": "TLS 1.3 uses a staged HKDF key schedule. This is a conceptual teaching view, not a cryptographic implementation.",
        "position": {
          "x": 280,
          "y": 300
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "http",
        "title": "Encrypted HTTP",
        "op": "http",
        "description": "Send protected application records.",
        "detail": "Encryption hides content, not all metadata. Do not mistake an encrypted channel for a trustworthy application.",
        "position": {
          "x": 0,
          "y": 300
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      },
      {
        "id": "audit",
        "title": "Connection outcome",
        "op": "audit",
        "description": "Record success or the reason for aborting.",
        "detail": "Never work around a certificate warning by disabling validation in a real client.",
        "position": {
          "x": 280,
          "y": 520
        },
        "requires": [],
        "produces": [],
        "timeoutMs": 5000,
        "retries": 1
      }
    ],
