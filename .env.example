# Copy to .env.local. Never put secrets in NEXT_PUBLIC_* variables.
DATABASE_URL=
# A canonical HTTPS origin is required when hosted; localhost for local development.
APP_ORIGIN=http://127.0.0.1:3100
CRON_SECRET=
# Optional AI: both values required. Choose a model with Responses structured outputs support.
OPENAI_API_KEY=
OPENAI_MODEL=
# External lookups are disabled by default; authenticated users only.
ENABLE_EXTERNAL_LOOKUPS=false
NVD_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# Seed only, remove these after running db:seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TENANT_NAME=Cyber AI Workspace
